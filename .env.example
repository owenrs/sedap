# SEDAP environment template — placeholders only, never commit real secrets.
APP_ENV=development

# PostgreSQL + pgvector connection URI (must be a valid postgresql:// URI)
DATABASE_URL=postgresql://user:pass@localhost:5432/sedap

# JWT/session signing key — generate a strong random value for real use
SECRET_KEY=change-me-to-a-strong-random-secret

# Optional integrations
OPENAI_API_KEY=sk-your-openai-key-here
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
